# EmailJS — copy this to .env.local and fill in your credentials.
# Create a free account at https://www.emailjs.com/
# Service ID:  Settings > Email Services
# Template ID: Email Templates > your template
# Public key:  Account > API Keys

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Pre-fills the email field on the review page (optional)
VITE_DEMO_EMAIL=

# Base URL used to build links in the outgoing email
VITE_PUBLIC_BASE_URL=

# Supabase: Project Settings > API. Use the anon / publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Insights API (Pipeline B backend)
VITE_INSIGHTS_API_URL=http://localhost:8000
