# EmailJS — copy this to .env.local and fill in your credentials.
# Create a free account at https://www.emailjs.com/
# Service ID:  Settings > Email Services
# Template ID: Email Templates > your template
# Public key:  Account > API Keys

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Pre-fills the email field on the review page (optional)
VITE_DEMO_EMAIL=

# Full app URL, https, no trailing slash. Set in Vercel Production only. Preview and local dev fall back to window.location.origin.
VITE_PUBLIC_BASE_URL=

# Supabase: Project Settings > API. Use the anon / publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API (FastAPI). Dev default: http://localhost:8000.
# Production: the Render backend URL (set in Vercel env vars).
VITE_INSIGHTS_API_URL=

# Admin token for AI endpoints (POST /insights/generate, POST /bank/draft).
# Required only when using ?admin=1 mode on the frontend.
VITE_ADMIN_TOKEN=
